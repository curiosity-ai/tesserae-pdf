{
    // One ES module per chunk, plus an entry module - the shape every Tesserae/Curiosity front-end is
    // built as. A chunk is a strongly-connected component of the reference graph, and because this
    // project is IsPackable, tps publishes a chunk map rather than an entry that imports all of them:
    // an application that references this package but never opens a PDF never fetches its JavaScript.
    // A Debug build ignores this and emits one readable bundle, which is what stepping through is for.
    "outputBy": "Module",

    // Not scripted by the consuming application's index.html. The chunks defer on their own (below),
    // but the module entry - the chunk map plus the reflection metadata of every type in here, some
    // 120 KB - would still be fetched and evaluated on every page load of an application whose users
    // may never open a PDF. So the entry is fetched by the application itself, just before it needs it:
    //
    //     await Transpose.Require.RequireAsync(Transpose.RequireKind.Module, "./Tesserae.Pdf.js");
    //
    // (Tesserae.Pdf.Sample does it first thing in Main; an application does it on the way to its PDF
    // view.) Every variant of the output is still embedded and still copied into the site - this only
    // says "do not load it for me". Until that call has run, nothing in the Tesserae.Pdf namespace
    // exists, so it has to come before the first reference to any type in this package.
    "loadCompiledOutput": false,

    // The reflection metadata rides inside the bundle rather than in a sibling .meta.js: the entry is
    // fetched as one file by the call above, and a second file it does not know to ask for would never
    // arrive. In Release the module entry carries its metadata inline anyway; this is what makes a
    // Debug build behave the same.
    "reflection": { "target": "inline" },

    // NOTE: the compiled output of this project needs no "resources" entry. Every variant of it - the
    // formatted bundle, the minified bundle, and the module entry with its chunks - is embedded
    // automatically for a packable project, and the referencing application keeps the set its own
    // configuration calls for. The four self-JS entries that used to be declared here (and the
    // "outputFormatting": "Both" above them) were a Bridge-era workaround for a consumer that could
    // not choose; "outputFormatting" no longer exists and is silently ignored.
    //
    // The pdf.js distribution itself is deliberately NOT a Transpose resource either. It is packed
    // into the NuGet package under pdfjs/ and copied into the consuming project's output by
    // buildTransitive/Tesserae.Pdf.targets instead. Three reasons:
    //   - Transpose emits a <script> tag for every ".js" resource. pdf.js is loaded on demand by the
    //     components (nothing is fetched until a viewer mounts), and the worker and the scripting
    //     sandbox must NOT be injected at all - they are loaded by pdf.js itself, as a module worker
    //     and a dynamic import respectively.
    //   - A resource is renamed into a ".min.js" variant, and both of those files are located by a
    //     name their own loader expects.
    //   - The "files" globs are single-level, so the asset tree (cmaps/, standard_fonts/, wasm/,
    //     iccs/, images/ - some 260 files) cannot be expressed without one entry per folder.

    "cleanOutputFolderBeforeBuildPattern": "*.*",
    "loader": {
        "type": "Global"
    },
    "generateTypeScript": false,
    "generateDocumentation": "None",
    "rules": {
        "anonymousType": "Plain",
        "arrayIndex": "Managed",
        "autoProperty": "Plain",
        "boxing": "Managed",
        "externalCast": "Plain",
        "inlineComment": "Plain",
        "integer": "Managed",
        "lambda": "Plain",
        "useShortForms": true
    },
    "sourceMap": {
        "enabled": false
    }
}
