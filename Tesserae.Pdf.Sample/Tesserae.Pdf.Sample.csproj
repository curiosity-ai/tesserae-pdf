<Project Sdk="Transpose.Build.Target/26.7.3049">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <DefineConstants>TRANSPOSE</DefineConstants>
    <AssemblyName>app</AssemblyName>
    <RootNamespace>Tesserae.Pdf.Sample</RootNamespace>
    <LangVersion>7.2</LangVersion>
    <MinifyLocalVariables>true</MinifyLocalVariables>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Transpose.BCL" Version="26.8.4275" />
    <PackageReference Include="Transpose.Core" Version="26.8.4176" />
    <PackageReference Include="Tesserae" Version="2026.8.69740" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tesserae.Pdf\Tesserae.Pdf.csproj" />
  </ItemGroup>

  <!--
    A PackageReference would get this automatically (it lives in the package's buildTransitive/), but
    a ProjectReference does not import the referenced project's targets - so the sample imports it by
    hand. This is the same file a real consumer runs, which is the point: the sample exercises the
    actual pdf.js asset copy rather than a bespoke one.
  -->
  <Import Project="..\Tesserae.Pdf\buildTransitive\Tesserae.Pdf.targets" />

  <!--
    The sample PDFs the gallery opens. Safe alongside the compiler's own output cleaning, which is
    scoped to "*.js|*.css" by tps.json - a pdf in that folder survives a rebuild.
  -->
  <Target Name="_CopySamplePdfs" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_SamplePdfs Include="assets\pdfs\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(_SamplePdfs)"
          DestinationFiles="@(_SamplePdfs->'$(OutDir)tps\assets\pdfs\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
